s200 200000 late() {
        catn("SNAPSHOT_200K\t" + sim.cycle + "\t" + time() + "\t" + date());
        writeSnapshot(sim.cycle);
}


// ------------------------------------------------------------
// Burn-in end snapshot — rescheduled when pi converges
// ------------------------------------------------------------
s3 100000000 late() {
        catn("SNAPSHOT_BURN_END\t" + sim.cycle + "\t" + time() + "\t" + date());
        writeSnapshot(sim.cycle);

        endGen = sim.cycle + STAB_PERIOD;
        community.rescheduleScriptBlock(s4, endGen, endGen);
        catn("Stabilization: " + STAB_PERIOD + " gens -> END snapshot at gen " + endGen);

        sim.setValue("burn_done", T);
}


// ------------------------------------------------------------
// Final END snapshot
// ------------------------------------------------------------
s4 100000000 late() {
        catn("SNAPSHOT_END\t" + sim.cycle + "\t" + time() + "\t" + date());

        sim.outputFull(out_prefix + "_fulloutput_END_gen" + sim.cycle + ".slim");
        writeMutFile(sim.cycle);

        writeFile(out_hs, geths(p1), append=F);

        sampledInds    = sample(p1.individuals, min(TAJIMA_N, p1.individualCount));
        muts_m1_sample = unique(sampledInds.haplosomes.mutationsOfType(m1));
        D = 0.0;
        if (size(muts_m1_sample) > 0)
                D = calcTajimasD(sampledInds.haplosomes, muts_m1_sample);
        catn("END Tajima's D = " + D);

        sim.setValue("end_done", T);
        sim.simulationFinished();
}


