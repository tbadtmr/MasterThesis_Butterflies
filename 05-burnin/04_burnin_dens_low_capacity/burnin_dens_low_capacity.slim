// ------------------------------------------------------------
// getNeutLine: one line for NeutPi.txt
// ------------------------------------------------------------
function (s) getNeutLine(o pop)
{
        muts_m1   = unique(pop.haplosomes.mutationsOfType(m1));
        pi_global = calcHeterozygosity(pop.haplosomes, muts_m1);

        i2.evaluate(pop);
        target = pop.individuals[0];
        indvs  = unique(i2.drawByStrength(target, 50));
        pi_spatial = 0.0; spatN = 0; spatCoords = "NA";

        if (size(indvs) > 0) {
                total = 0.0;
                for (ind in indvs) {
                        muts0    = ind.haplosomes[0].mutationsOfType(m1);
                        muts1    = ind.haplosomes[1].mutationsOfType(m1);
                        shared   = sum(match(muts0, muts1) >= 0);
                        unshared = size(muts0) + size(muts1) - 2 * shared;
                        total    = total + unshared / chromLen;
                }
                pi_spatial = total / size(indvs);
                spatN      = size(indvs);
                spatCoords = paste(target.spatialPosition, sep=",");
        }

        D = 0.0;  // placeholder during burn-in reporting

        return sim.cycle + "\t" + pop.id + "\t" + pi_global + "\t" +
                pi_spatial + "\t" + spatN + "\t" + spatCoords + "\t" + D + "\t" +
                pop.individualCount;
}


// ------------------------------------------------------------
// getPopSumm: full genetics summary including both FROH columns
//
// FROH_100kb_19Mb  — raw chr9 FROH (primary comparison value)
//   = calcMeanFroh(inds, 100kb) / chromLen
//   Interpretation: fraction of simulated chromosome in ROH > 100kb.
//   Used as genome-wide FROH estimate under the assumption that
//   chr9 is representative of genome-wide IBD (Pinto et al. 2023).
//   This is the value to compare against Nolen et al. empirical data.
//
// FROH_100kb_416Mb — scaled value (f_chr9 * chromLen / FULL_GENOME)
//   Interpretation: fraction of FULL autosomal genome in ROH,
//   assuming only chr9 contributes ROH and all other chromosomes have zero.
//   This is a conservative lower bound, kept here for reference only.
//
// froh_for_load    = f100kb_19 (Bertorelle equations use the representative
//                   genome assumption, consistent with Nolen et al.)
// ------------------------------------------------------------
function (s) getPopSumm(o pop)
{
        inds      = pop.individuals;
        indvCount = size(inds);

        if (indvCount == 0)
                return sim.cycle + "\t" + pop.id +
                "\t0\t0\t0\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA";

        // Raw chr9 FROH (primary)
        f100kb_19  = calcMeanFroh(inds, ROH_CUTOFF_100KB);
        // Scaled comparison value
        sf         = asFloat(chromLen) / asFloat(FULL_GENOME);
        f100kb_416 = f100kb_19 * sf;

        // Load equations use chr9 FROH as representative of full genome
        froh_for_load  = f100kb_19;

        fitness_cached = pop.cachedFitness(inds.index);
        m_uniq         = unique(inds.uniqueMutationsOfType(m2));
        Mutcount       = size(m_uniq);

        if (Mutcount == 0) {
                return sim.cycle + "\t" + pop.id + "\t" + indvCount +
                        "\t0\t0\t0\t0\t0\t0\t0\t0\t0\t0\t0\t" +
                        f100kb_19 + "\t" + f100kb_416 + "\t" +
                        mean(fitness_cached) + "\t" + sd(fitness_cached);
        }

        freqMut  = sim.mutationFrequencies(pop, m_uniq);
        ScoefMut = abs(m_uniq.selectionCoeff);
        DcoefMut = m_uniq.getValue("dom");

        HomAlt = sapply(m_uniq,
                "sum(inds.haplosomes[0].containsMutations(applyValue) & " +
                "inds.haplosomes[1].containsMutations(applyValue)) / indvCount;");
        Het = sapply(m_uniq,
                "sum(inds.haplosomes[0].containsMutations(applyValue) != " +
                "inds.haplosomes[1].containsMutations(applyValue)) / indvCount;");

        mHet         = mean(Het);
        mLoad_homo   = sum(ScoefMut * HomAlt);
        mLoad_hetero = sum(ScoefMut * DcoefMut * Het);
        mLoad        = mLoad_homo + mLoad_hetero;
        totalLoad    = sum(freqMut * ScoefMut);

        relzLoad = sum(freqMut^2 * ScoefMut) +
                2 * sum(freqMut * (1 - freqMut) * ScoefMut * DcoefMut);
        mskLoad  = totalLoad - relzLoad;

        relzLoad_FROH = sum((1 - froh_for_load) * freqMut^2 * ScoefMut +
                froh_for_load * freqMut * ScoefMut) +
                2 * (1 - froh_for_load) *
                sum(freqMut * (1 - freqMut) * ScoefMut * DcoefMut);
        mskLoad_FROH  = totalLoad - relzLoad_FROH;

        mutFixed = sum(HomAlt == 1.0);

        return sim.cycle + "\t" + pop.id + "\t" + indvCount + "\t" +
                Mutcount + "\t" + mutFixed + "\t" + mHet + "\t" +
                mLoad_homo + "\t" + mLoad_hetero + "\t" + mLoad + "\t" +
                totalLoad + "\t" + relzLoad + "\t" + mskLoad + "\t" +
                relzLoad_FROH + "\t" + mskLoad_FROH + "\t" +
                f100kb_19 + "\t" + f100kb_416 + "\t" +
                mean(fitness_cached) + "\t" + sd(fitness_cached);
}


// ------------------------------------------------------------
// geths: per-mutation s/h/freq — only written at final END
// ------------------------------------------------------------
function (s) geths(o pop)
{
        m_uniq = unique(pop.individuals.uniqueMutationsOfType(m2));
        if (size(m_uniq) == 0) return "no_m2_mutations";
        freqMut  = sim.mutationFrequencies(pop, m_uniq);
        ScoefMut = abs(m_uniq.selectionCoeff);
        DcoefMut = m_uniq.getValue("dom");
        return sim.cycle + "\t" + pop.id + "\t" +
                freqMut + "\t" + ScoefMut + "\t" + DcoefMut;
}


// ------------------------------------------------------------
// writeSnapshot: full .slim state + mutation file
// ------------------------------------------------------------
function (void) writeSnapshot(i gen)
{
        sim.outputFull(out_prefix + "_fulloutput_gen" + gen + ".slim");
        writeMutFile(gen);
}

function (void) writeMutFile(i gen)
{
        mut = unique(p1.haplosomes.mutationsOfType(m2));
        if (size(mut) > 0) {
                out = gen + "\t" + mut.id + "\t" + mut.position + "\t" +
                        mut.selectionCoeff + "\t" + mut.getValue("dom") + "\t" +
                        sim.mutationFrequencies(p1, mut);
                writeFile(out_prefix + "_m2_gen" + gen + ".txt", out);
        }
}
