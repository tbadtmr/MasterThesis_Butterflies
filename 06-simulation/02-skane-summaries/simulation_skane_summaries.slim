// ============================================================================
// Cyaniris semiargus — Skåne lightweight summary simulation
//
// Computationally reduced version of the final production simulation used to
// obtain a larger replicate set for demographic and genomic trajectories.
//
// The biological model and parameterisation are unchanged from the full-area
// simulation. The spatial domain is restricted to Skåne and large full-
// population snapshots are omitted to substantially reduce computational cost.
//
// Final thesis parameterisation:
//   DENS_MAX      = 120
//   K_EXPONENT    = 1.3
//   K_GLOBAL_CAP  = 120000
//   REGION_MODE   = skane_only
//
// Scenarios:
//   status_quo, restore_2km, restore_4km, restore_6km
//
// Historical HILDA+ landscapes are used through 2019. The 2019 landscape is
// the shared 2020 baseline and scenario-specific future landscapes are applied
// from 2021 onward.
//
// The selected generation-117000 burn-in state is supplied externally through
// BURNIN_SNAPSHOT and BURNIN_M2_FILE.
// ============================================================================

initialize() {
    initializeSLiMModelType("nonWF");
    initializeSLiMOptions(dimensionality="xy", nucleotideBased=F);
    initializeSex("A");

    // ----------------------------
    // ECOLOGY — match current burn-in script
    // ----------------------------
    defineConstant("MEAN_EGGS",        100);
    defineConstant("EGG_MAX",          700);
    defineConstant("S_total",         0.03);
    defineConstant("FECUN_EFF", MEAN_EGGS * S_total);
    defineConstant("FEC_DD_STRENGTH",  1.0);

    // ----------------------------
    // Spatial scale
    // ----------------------------
    defineConstant("W",         340.0);
    defineConstant("H",         277.0);
    defineConstant("SPACE_SIGMA", 0.5);
    defineConstant("DISP_SD", 2.0);
    defineConstant("SI",      0.5);
    defineConstant("SM",      0.5);
    defineConstant("P_LDD",        0.1);
    defineConstant("DISP_SD_LDD", 15.0);
    defineConstant("N_CANDIDATES", 5);
    defineConstant("DISP_BIAS_FLOOR", 0.01);

    // ----------------------------
    // Landscape / density dependence
    // ----------------------------
    defineConstant("OPT_THRESH",  0.01);
    defineConstant("MAX_SURV",    0.8);
    if (!exists("DENS_MAX"))
        defineConstant("DENS_MAX", 120.0);
    defineConstant("USABLE_FRAC", 0.8);
    if (!exists("K_EXPONENT"))
        defineConstant("K_EXPONENT", 1.3);
    defineConstant("HAB_FLOOR",  0.01);

    // ----------------------------
    // Global cap
    // ----------------------------
    defineConstant("USE_GLOBAL_CAP", T);
    if (!exists("K_GLOBAL_CAP"))
        defineConstant("K_GLOBAL_CAP", 120000.0);

    // ----------------------------
    // PHASE TIMING
    // This script loads an already stabilised burn-in END snapshot.
    // Set BURNIN_GEN to the cycle stored in that snapshot.
    // After loading, run STABILIZE_GEN generations on the 1899 landscape
    // with no output, then begin year 1899 at C_HIST_START.
    // ----------------------------
    defineConstant("BURNIN_GEN",     117000);   // cycle of loaded burn-in END snapshot
    defineConstant("STABILIZE_GEN",     100);   // no-output resume stabilisation on 1899 map

    defineConstant("YEAR_START",             1899);
    defineConstant("YEAR_LAST_OBSERVED_MAP", 2019); // last annual HILDA map used as-is
    defineConstant("YEAR_BASELINE_END",      2020); // common modern baseline; still uses 2019 map
    defineConstant("FUTURE_START_YEAR",      2021); // restoration/future scenario starts here
    defineConstant("YEAR_END",               2519);

    defineConstant("N_BASELINE", YEAR_BASELINE_END - YEAR_START + 1);      // 1899-2020 inclusive
    defineConstant("N_FUTURE",   YEAR_END - FUTURE_START_YEAR + 1);        // 2021-2519 inclusive

    defineConstant("C_STAB_START",    BURNIN_GEN + 1);                         // first stabilisation cycle
    defineConstant("C_STAB_END",      BURNIN_GEN + STABILIZE_GEN);             // last stabilisation cycle
    defineConstant("C_HIST_START",    C_STAB_END + 1);                         // year 1899
    defineConstant("C_BASELINE_END",  C_HIST_START + N_BASELINE - 1);           // year 2020
    defineConstant("C_FUT_START",     C_HIST_START + (FUTURE_START_YEAR - YEAR_START)); // year 2021
    defineConstant("TMAX",            C_HIST_START + (YEAR_END - YEAR_START)); // year 2519

    // Snapshot years:
    // 1900 baseline, 1951/1956 empirical historical points,
    // 2020 common modern baseline on the 2019 map,
    // then future monitoring points under the selected scenario.
    defineConstant("SNAPSHOT_YEARS", c(1900, 1951, 1956, 2020, 2140, 2260, 2380, 2500));
    defineConstant("SNAPSHOT_LABELS", c(
        "year1900_baseline",
        "year1951_historical_sample",
        "year1956_historical_sample",
        "year2020_modern_baseline",
        "year2140_future_120",
        "year2260_future_240",
        "year2380_future_360",
        "year2500_future_480"
    ));
    defineConstant("SNAPSHOT_CYCLES", C_HIST_START + (SNAPSHOT_YEARS - YEAR_START));


    // Reporting intervals
    // Genetics/load/IBD: every 5 years through 2140, then every 50 years after 2140,
    // always also at snapshot years.
    defineConstant("ECO_FUTURE_INT", 10);     // ecology every 10 years in future
    defineConstant("GEN_INT_FAST",    5);     // genetics/load/IBD every 5 years until year 2140
    defineConstant("GEN_INT_LATE",   50);     // genetics/load/IBD every 50 years after year 2140
    defineConstant("GEN_FAST_END_YEAR", 2140);
    if (!exists("IBD_N_PAIRS"))
        defineConstant("IBD_N_PAIRS", 100);
    if (!exists("WRITE_IBD"))
        defineConstant("WRITE_IBD", F);
    defineConstant("FROH_SAMPLE_N", 1000);

    // ----------------------------
    // GENOME — match burn-in
    // ----------------------------
    defineConstant("MU",  2.9e-9);
    defineConstant("R_M", 2.5e-8);
    defineConstant("R_F", 0.0);
    defineConstant("ROH_CUTOFF_100KB", 100000);
    defineConstant("TAJIMA_N", 20);

    // ----------------------------
    // Dardel paths and run controls
    // ----------------------------
    // Run like:
    //
    // status_quo, restore_0p5km, restore_1km, restore_2km, restore_4km, restore_6km, restore_8km
    if (!exists("BASE_DIR"))
        defineConstant("BASE_DIR", ".");
    if (!exists("SCENARIO"))
        defineConstant("SCENARIO", "status_quo");

    if (!exists("BURNIN_SNAPSHOT"))
        stop("BURNIN_SNAPSHOT must be supplied by the launch script.");
    if (!exists("BURNIN_M2_FILE"))
        stop("BURNIN_M2_FILE must be supplied by the launch script.");

    defineConstant("burnin_slim", BURNIN_SNAPSHOT);
    defineConstant("burnin_m2", BURNIN_M2_FILE);

    defineConstant("map_dir",        BASE_DIR + "/03-model_input/suit_maps/");
    defineConstant("future_map_dir", BASE_DIR + "/03-model_input/future_scenarios/");
    defineConstant("coord_file_in",  BASE_DIR + "/03-model_input/coord_chr9.txt");

    // Region masks for regional simulations.
    // REGION_MODE is passed from the wrapper:
    //   full       = no masking
    //   skane_only = keep only Skåne mask
    //   no_oland   = remove Öland mask
    if (!exists("REGION_MODE"))
        defineConstant("REGION_MODE", "full");

    defineConstant("region_mask_dir", BASE_DIR + "/03-model_input/region_masks/");

    if (REGION_MODE == "full")
        defineConstant("region_mask_file", region_mask_dir + "region_mask_full.txt");
    else if (REGION_MODE == "skane_only")
        defineConstant("region_mask_file", region_mask_dir + "region_mask_skane_only.txt");
    else if (REGION_MODE == "no_oland")
        defineConstant("region_mask_file", region_mask_dir + "region_mask_no_oland.txt");
    else
        stop("Unknown REGION_MODE: " + REGION_MODE);

    // ----------------------------
    // OUTPUT FILES
    // ----------------------------
    // For multiple replicates, pass a different REP_ID or OUT_DIR from the command line.
    if (!exists("OUT_TAG"))
        defineConstant("OUT_TAG", "rerun2021future");
    if (!exists("REP_ID"))
        defineConstant("REP_ID", "rep001");
    if (!exists("OUT_DIR"))
        defineConstant("OUT_DIR", BASE_DIR + "/06-simulation/02-skane-summaries/output/" + SCENARIO + "/" + REP_ID + "/");
    defineConstant("out_dir", OUT_DIR);
    defineConstant("out_eco",     out_dir + "ecology.txt");
    defineConstant("out_neut",    out_dir + "NeutPi.txt");
    defineConstant("out_load",    out_dir + "summaryLoad.txt");
    defineConstant("out_ibd",     out_dir + "IBD_pairs.txt");
    defineConstant("out_hs",      out_dir + "hs_chr9_final.txt");
    defineConstant("out_prefix",  out_dir + "main_chr9");

    // ----------------------------
    // GENETICS INIT
    // ----------------------------
    coord_lines = readFile(coord_file_in);
    lastRow = strsplit(coord_lines[length(coord_lines) - 1], "\t");
    defineConstant("chromLen", asInteger(lastRow[4]) + 1);
    defineConstant("seqLength", chromLen);

    initializeMutationType("m1", 0.5, "f", 0.0);
    m1.convertToSubstitution = T;

    initializeMutationType("m2", 0.5, "g", -0.013, 0.186);
    m2.convertToSubstitution = F;

    delCoef = c(rexp(800, 0.05), rexp(200, 0.4));
    delCoef = delCoef[delCoef <= 0.5];
    defineConstant("delCoef_distr", delCoef);

    initializeGenomicElementType("g1", c(m1, m2), c(0.6, 0.4));
    initializeGenomicElementType("g2", c(m1, m2), c(0.6, 0.4));
    initializeGenomicElementType("g3", m1, 1.0);

    for (line in coord_lines) {
        fields = strsplit(line, "\t");
        if (fields[0] != "V1") {
            feature  = fields[2];
            startPos = asInteger(fields[3]);
            endPos   = asInteger(fields[4]);
            if (feature == "exon")
                initializeGenomicElement(g1, startPos, endPos);
            else if (feature == "intron")
                initializeGenomicElement(g2, startPos, endPos);
            else if (feature == "non_coding")
                initializeGenomicElement(g3, startPos, endPos);
        }
    }

    initializeMutationRate(MU);
    initializeRecombinationRate(R_M, sex="M");
    initializeRecombinationRate(R_F, sex="F");

    initializeInteractionType(1, "xy", reciprocal=T, maxDistance=SI * 3);
    i1.setInteractionFunction("n", (1.0 / (2.0 * PI * SI^2)), SI);

    initializeInteractionType(2, "xy", reciprocal=T, maxDistance=SM * 3, sexSegregation="FM");
    i2.setInteractionFunction("n", 1.0, SM);
}

// ------------------------------------------------------------
// Dominance
// ------------------------------------------------------------
mutation(m2) {
    mut.setValue("dom", sample(asFloat(delCoef_distr), 1));
    return T;
}

mutationEffect(m2) {
    if (homozygous)
        return 1.0 + mut.selectionCoeff;
    else
        return 1.0 + mut.getValue("dom") * mut.selectionCoeff;
}

// ------------------------------------------------------------
// Cycle 1 early: load stabilised burn-in snapshot, restore m2 dominance,
// load the 1899 map.
// ------------------------------------------------------------
1 early() {
    sim.readFromPopulationFile(burnin_slim);
    p1.setSpatialBounds(c(0.0, 0.0, W, H));

    loadRegionMask();
    filterIndividualsByRegion(T);

    m2File = readFile(burnin_m2);
    id = c(); h = c();
    for (line in m2File) {
        fields = strsplit(line, "\t");
        id = c(id, asFloat(fields[1]));
        h  = c(h,  asFloat(fields[4]));
    }
    for (mut in sim.mutationsOfType(m2)) {
        idx = match(asInteger(mut.id), asInteger(id));
        if (length(idx) != 1)
            catn("WARNING: unmatched m2 ID " + mut.id);
        else
            mut.setValue("dom", h[idx]);
    }

    loadMap(YEAR_START);

    catn("=== Resume simulation loaded from stabilised burn-in snapshot ===");
    catn("Resume snapshot : " + burnin_slim);
    catn("N at load       : " + p1.individualCount);
    catn("BURNIN_GEN      : " + BURNIN_GEN);
    catn("Stabilisation   : cycles " + C_STAB_START + "-" + C_STAB_END + " on 1899 map, no output");
    catn("Baseline/history: cycles " + C_HIST_START + "-" + C_BASELINE_END + " = years 1899-2020");
    catn("Map rule        : 1899-2018 annual maps; 2019 and 2020 both use hilda_suitability_2019.txt");
    catn("Future          : cycles " + C_FUT_START + "-" + TMAX + " = years 2021-" + cycleToYear(TMAX) + " use scenario map " + SCENARIO);
    catn("Burn-in snapshot : " + burnin_slim);
    catn("Scenario        : " + SCENARIO);
    catn("Output dir      : " + out_dir);
    catn("Future map      : " + getFutureMapFile());
    catn("Snapshot years  : " + paste(SNAPSHOT_YEARS, sep=","));
    catn("Snapshot cycles : " + paste(SNAPSHOT_CYCLES, sep=","));

    // Initialise counters immediately after loading.
    resetCounters();
}

// ------------------------------------------------------------
// Cycle 1 first: write output file headers
// ------------------------------------------------------------
1 first() {
    writeFile(out_eco,
        "cycle\tyear\tphase\tN_end\tadultF\tadultM\tfemales_laid\teggs_laid\teggs_mean\teggs_sd\t" +
        "meanFecScale\tmeanEggsExpected\trecruits_created\trecruits_viable\t" +
        "culled_water\tmeanSuitAdults\tmeanCompRecr\tmeanDDsurvRecr\t" +
        "meanKlocRecr\tmeanRHOrecr\texpNextN\tglobalScale",
        append=F);

    writeFile(out_neut,
        "cycle\tyear\tphase\tpop\tpi_global\tpi_spatial\tspatial_N\tspatial_coords\ttajimasD\tN",
        append=F);

    writeFile(out_load,
        "cycle\tyear\tphase\tpop\tN\tmutCount\tmutFixed\tmeanHet_m2\t" +
        "loadHomo\tloadHetero\tloadTotal\t" +
        "totalLoad\trealizedLoad\tmaskedLoad\t" +
        "realizedLoad_FROH\tmaskedLoad_FROH\t" +
        "FROH_100kb_chr9_sample1000\tFROH_N\t" +
        "meanCachedFitness\tsdCachedFitness",
        append=F);

    if (WRITE_IBD) {
        writeFile(out_ibd,
            "cycle\tyear\tphase\tpair_id\tpopsize\tdiffbyBP_m1\tspatial_dist\tind1_pos\tind2_pos",
            append=F);
    }
}

// ------------------------------------------------------------
// Reset counters + evaluate interactions each cycle
// ------------------------------------------------------------
C_STAB_START:TMAX first() {
    resetCounters();
    i1.evaluate(p1);
    i2.evaluate(p1);
}

// ------------------------------------------------------------
// Map loading
// Stabilisation phase: keep the 1899 map loaded at cycle 1.
// Historical phase: update annual map 1899-2019.
// Future phase: use the selected scenario map.
// ------------------------------------------------------------
C_STAB_START:TMAX early() {
    if (sim.cycle >= C_HIST_START & sim.cycle <= TMAX) {
        year = cycleToYear(sim.cycle);
        loadMap(year);
    }
}

// ------------------------------------------------------------
// Reproduction — adapted from current burn-in ecology
// ------------------------------------------------------------
C_STAB_START:TMAX reproduction(p1, "F") {
    if (individual.age < 1)
        return;

    mate = i2.drawByStrength(individual, 1);
    if (mate.size() == 0)
        return;

    momPos = individual.spatialPosition;

    compA     = i1.totalOfNeighborStrengths(individual);
    suitA_raw = pmax(0.0, p1.spatialMapValue("suit", momPos));
    suitA     = HAB_FLOOR + (1.0 - HAB_FLOOR) * suitA_raw;
    KlocA     = pmax(1e-9, DENS_MAX * USABLE_FRAC * (suitA_raw^K_EXPONENT));
    RHO_A     = FECUN_EFF / ((1.0 + FECUN_EFF) * KlocA);
    fecDen    = suitA + FEC_DD_STRENGTH * RHO_A * compA + 1e-12;
    fecScale  = pmax(0.0, pmin(1.0, suitA / fecDen));

    meanEggsLocal = MEAN_EGGS * fecScale;

    sim.setValue("fec_scale_sum",    sim.getValue("fec_scale_sum") + fecScale);
    sim.setValue("fec_eggs_exp_sum", sim.getValue("fec_eggs_exp_sum") + meanEggsLocal);
    sim.setValue("fec_n",            sim.getValue("fec_n") + 1);

    nEggs = rpois(1, meanEggsLocal);
    if (nEggs > EGG_MAX) nEggs = EGG_MAX;
    if (nEggs <= 0) return;

    sim.setValue("females_laid", sim.getValue("females_laid") + 1);
    sim.setValue("eggs_laid",    sim.getValue("eggs_laid") + nEggs);
    sim.setValue("eggs_sq_laid", sim.getValue("eggs_sq_laid") + (nEggs * nEggs));

    nRecruit = rbinom(1, nEggs, S_total);
    if (nRecruit <= 0) return;

    for (i in seqLen(nRecruit)) {
        off = subpop.addCrossed(individual, mate);
        off.age = 0;

        if (runif(1) < P_LDD) {
            tries = 0;
            x = momPos[0] + rnorm(1, 0.0, DISP_SD_LDD);
            y = momPos[1] + rnorm(1, 0.0, DISP_SD_LDD);
            x = max(0.0, min(W, x));
            y = max(0.0, min(H, y));
            pos = c(x, y);
            s = p1.spatialMapValue("suit", pos);

            while (s <= OPT_THRESH & tries < 10) {
                x = momPos[0] + rnorm(1, 0.0, DISP_SD_LDD);
                y = momPos[1] + rnorm(1, 0.0, DISP_SD_LDD);
                x = max(0.0, min(W, x));
                y = max(0.0, min(H, y));
                pos = c(x, y);
                s = p1.spatialMapValue("suit", pos);
                tries = tries + 1;
            }

            off.setSpatialPosition(pos);
            if (s <= OPT_THRESH) {
                off.fitnessScaling = 0.0;
                sim.setValue("culled_water", sim.getValue("culled_water") + 1);
            }
        }
        else {
            candX = asFloat(c()); candY = asFloat(c());
            candW = asFloat(c()); candS = asFloat(c());

            for (j in seqLen(N_CANDIDATES)) {
                x = momPos[0] + rnorm(1, 0.0, DISP_SD);
                y = momPos[1] + rnorm(1, 0.0, DISP_SD);
                x = max(0.0, min(W, x));
                y = max(0.0, min(H, y));
                posJ = c(x, y);
                sJ = p1.spatialMapValue("suit", posJ);
                candX = c(candX, x); candY = c(candY, y);
                candW = c(candW, pmax(DISP_BIAS_FLOOR, sJ));
                candS = c(candS, sJ);
            }

            chosen = sample(0:(size(candW)-1), 1, weights=candW);
            pos = c(candX[chosen], candY[chosen]);
            s   = candS[chosen];

            off.setSpatialPosition(pos);
            if (s <= OPT_THRESH) {
                off.fitnessScaling = 0.0;
                sim.setValue("culled_water", sim.getValue("culled_water") + 1);
            }
        }
    }

    sim.setValue("recruits_created", sim.getValue("recruits_created") + nRecruit);
}

// ------------------------------------------------------------
// Density-dependent recruit survival + annual turnover
// ------------------------------------------------------------
C_STAB_START:TMAX early() {
    inds     = p1.individuals;
    adults   = inds[inds.age >= 1];
    recruits = inds[inds.age == 0];

    i1.evaluate(p1);

    sim.setValue("adultF_now", sum(adults.sex == "F"));
    sim.setValue("adultM_now", sum(adults.sex == "M"));

    meanSuitAdultsNow = 0.0;
    if (adults.size() > 0)
        meanSuitAdultsNow = mean(p1.spatialMapValue("suit", adults.spatialPosition));
    sim.setValue("meanSuitAdults_now", meanSuitAdultsNow);

    if (recruits.size() > 0) {
        comp    = i1.totalOfNeighborStrengths(recruits);
        posR    = recruits.spatialPosition;
        suitRaw = pmax(0.0, p1.spatialMapValue("suit", posR));
        suitR   = HAB_FLOOR + (1.0 - HAB_FLOOR) * suitRaw;
        Kloc    = pmax(1e-9, DENS_MAX * USABLE_FRAC * (suitRaw^K_EXPONENT));
        RHO     = FECUN_EFF / ((1.0 + FECUN_EFF) * Kloc);
        den     = suitR + RHO * comp + 1e-12;
        dd      = pmax(0.0, pmin(MAX_SURV, suitR / den));

        recruits.fitnessScaling = recruits.fitnessScaling * dd;

        expNextN    = sum(recruits.fitnessScaling);
        globalScale = 1.0;
        if (USE_GLOBAL_CAP & expNextN > K_GLOBAL_CAP)
            globalScale = K_GLOBAL_CAP / expNextN;
        recruits.fitnessScaling = recruits.fitnessScaling * globalScale;

        sim.setValue("meanCompRecr",   mean(comp));
        sim.setValue("meanDDsurvRecr", mean(dd));
        sim.setValue("meanKlocRecr",   mean(Kloc));
        sim.setValue("meanRHOrecr",    mean(RHO));
        sim.setValue("expNextN",       expNextN);
        sim.setValue("globalScale",    globalScale);
    }

    if (adults.size() > 0)
        adults.fitnessScaling = 0.0;

    sim.setValue("recruits_viable", sum(recruits.fitnessScaling > 0.0));
}

// ------------------------------------------------------------
// Output, summaries, samples, snapshots
// ------------------------------------------------------------
C_STAB_START:TMAX late() {
    if (p1.individualCount <= 1) {
        catn("POPULATION COLLAPSE at cycle " + sim.cycle + " (year " + cycleToYear(sim.cycle) + ")");
        sim.simulationFinished();
    }

    // No output during the resume-stabilisation period.
    if (sim.cycle < C_HIST_START)
        return;

    phase = getPhase(sim.cycle);
    year  = cycleToYear(sim.cycle);

    // Ecology: no output during stabilisation; every cycle during historical phase; every 10 years in future.
    doEco = (phase == "historical") | ((phase == "future") & ((sim.cycle - C_FUT_START) % ECO_FUTURE_INT == 0)) | any(SNAPSHOT_CYCLES == sim.cycle);

    if (doEco) {
        writeEcoLine(year, phase);
    }

    // Genetic/load/IBD summaries:
    // every 5 years through 2140, then every 50 years after 2140,
    // always also at snapshot years.
    doGenetics = shouldWriteGenetics(sim.cycle);

    if (doGenetics) {
        writeFile(out_neut, getNeutLine(p1, year, phase), append=T);
        writeFile(out_load, getPopSumm(p1, year, phase),  append=T);
        if (WRITE_IBD)
            writeFile(out_ibd, getIBDPairs(p1, IBD_N_PAIRS, year, phase), append=T);
    }

    if (F & any(SNAPSHOT_CYCLES == sim.cycle)) {
        idx = which(SNAPSHOT_CYCLES == sim.cycle);
        label = SNAPSHOT_LABELS[idx];
        catn("SNAPSHOT_" + label + "\tcycle=" + sim.cycle + "\tyear=" + year + "\t" + time() + "\t" + date());
        writeSnapshot(sim.cycle, label);
    }

    if (sim.cycle == TMAX) {
        writeFile(out_hs, geths(p1), append=F);
        catn("Simulation finished. Final N = " + p1.individualCount);
        sim.simulationFinished();
    }
}

// ============================================================
// FUNCTIONS
// ============================================================

function (void) resetCounters(void) {
    sim.setValue("females_laid",       0);
    sim.setValue("eggs_laid",          0);
    sim.setValue("eggs_sq_laid",       0);
    sim.setValue("recruits_created",   0);
    sim.setValue("recruits_viable",    0);
    sim.setValue("culled_water",       0);
    sim.setValue("meanCompRecr",       0.0);
    sim.setValue("meanDDsurvRecr",     0.0);
    sim.setValue("meanKlocRecr",       0.0);
    sim.setValue("meanRHOrecr",        0.0);
    sim.setValue("adultF_now",         0);
    sim.setValue("adultM_now",         0);
    sim.setValue("meanSuitAdults_now", 0.0);
    sim.setValue("expNextN",           0.0);
    sim.setValue("globalScale",        1.0);
    sim.setValue("fec_scale_sum",      0.0);
    sim.setValue("fec_eggs_exp_sum",   0.0);
    sim.setValue("fec_n",              0);
}

function (void) loadRegionMask(void) {
    Ms = asFloat(readFile(region_mask_file));
    Ms = matrix(Ms, nrow=asInteger(H), ncol=asInteger(W), byrow=T);

    // Store matrix so loadMap() can reuse it without re-reading the file.
    sim.setValue("region_mask_matrix", Ms);

    // Also define as a spatial map so we can query individual positions.
    p1.defineSpatialMap("region_mask", "xy", Ms, interpolate=F,
        valueRange=c(0.0, 1.0), colors=c("black", "white"));

    catn("Region mode     : " + REGION_MODE);
    catn("Region mask     : " + region_mask_file);
}

function (void) filterIndividualsByRegion(logical$ doLog) {
    if (REGION_MODE == "full")
        return;

    inds = p1.individuals;

    if (length(inds) == 0)
        return;

    vals = p1.spatialMapValue("region_mask", inds.spatialPosition);
    outside = inds[vals < 0.5];

    if (doLog) {
        catn("Region filtering before: N=" + length(inds));
        catn("Removing outside region: " + length(outside));
    }

    if (length(outside) > 0)
        sim.killIndividuals(outside);

    if (doLog)
        catn("Region filtering after : N=" + p1.individualCount);
}

function (void) loadMap(i year) {
    if (year < YEAR_LAST_OBSERVED_MAP) {
        // Annual historical maps for 1899-2018.
        mapFile = map_dir + "hilda_suitability_" + year + ".txt";
    }
    else if (year <= YEAR_BASELINE_END) {
        // Shared modern baseline: 2019 and 2020 both use the 2019 map.
        // This prevents restoration/status-quo scenarios from diverging before 2021.
        mapFile = map_dir + "hilda_suitability_2019.txt";
    }
    else {
        // From 2021 onward use the selected restoration/status-quo scenario map.
        mapFile = getFutureMapFile();
    }

    if (year >= 2019 & (year == 2019 | year == 2020 | year == FUTURE_START_YEAR | any(SNAPSHOT_YEARS == year)))
        catn("LOADING_MAPyear=" + year + "scenario=" + SCENARIO + "file=" + mapFile);

    Xs = asFloat(readFile(mapFile));
    Xs = matrix(Xs, nrow=asInteger(H), ncol=asInteger(W), byrow=T);

    if (REGION_MODE != "full")
        Xs = Xs * sim.getValue("region_mask_matrix");

    p1.defineSpatialMap("suit", "xy", Xs, interpolate=T,
        valueRange=c(0.0, 1.0), colors=c("black", "green"));
}
function (s) getFutureMapFile(void) {
    if (SCENARIO == "status_quo" | SCENARIO == "statusquo")
        return future_map_dir + "hilda_suitability_2019_status_quo_2019.txt";
    if (SCENARIO == "restore_0p5km" | SCENARIO == "restore0p5km")
        return future_map_dir + "hilda_suitability_2020_restore_100pct_lost_within_0p5km.txt";
    if (SCENARIO == "restore_1km" | SCENARIO == "restore1km")
        return future_map_dir + "hilda_suitability_2020_restore_100pct_lost_within_1km.txt";
    if (SCENARIO == "restore_2km" | SCENARIO == "restore2km")
        return future_map_dir + "hilda_suitability_2020_restore_100pct_lost_within_2km.txt";
    if (SCENARIO == "restore_4km" | SCENARIO == "restore4km")
        return future_map_dir + "hilda_suitability_2020_restore_100pct_lost_within_4km.txt";
    if (SCENARIO == "restore_6km" | SCENARIO == "restore6km")
        return future_map_dir + "hilda_suitability_2020_restore_100pct_lost_within_6km.txt";
    if (SCENARIO == "restore_8km" | SCENARIO == "restore8km")
        return future_map_dir + "hilda_suitability_2020_restore_100pct_lost_within_8km.txt";

    stop("Unknown SCENARIO: " + SCENARIO);
    return "";
}

function (logical) shouldWriteGenetics(i cycle) {
    year = cycleToYear(cycle);

    if (any(SNAPSHOT_CYCLES == cycle))
        return T;

    if (year <= GEN_FAST_END_YEAR)
        return ((cycle - C_HIST_START) % GEN_INT_FAST == 0);

    return ((year - GEN_FAST_END_YEAR) % GEN_INT_LATE == 0);
}

function (s) getPhase(i cycle) {
    year = cycleToYear(cycle);
    if (year <= YEAR_LAST_OBSERVED_MAP) return "historical";
    if (year <= YEAR_BASELINE_END) return "modern_baseline";
    return "future";
}

function (i) cycleToYear(i cycle) {
    return YEAR_START + (cycle - C_HIST_START);
}

function (void) writeEcoLine(i year, s phase) {
    fLaid     = sim.getValue("females_laid");
    eggsTotal = sim.getValue("eggs_laid");
    eggsSq    = sim.getValue("eggs_sq_laid");
    fecN      = sim.getValue("fec_n");

    eggsMean = 0.0; eggsSD = 0.0;
    meanFecScale = 0.0; meanEggsExpected = 0.0;

    if (fLaid > 0) {
        eggsMean = eggsTotal / fLaid;
        varE = (eggsSq / fLaid) - (eggsMean^2);
        if (varE < 0.0) varE = 0.0;
        eggsSD = sqrt(varE);
    }
    if (fecN > 0) {
        meanFecScale     = sim.getValue("fec_scale_sum") / fecN;
        meanEggsExpected = sim.getValue("fec_eggs_exp_sum") / fecN;
    }

    ecoLine =
        sim.cycle + "\t" + year + "\t" + phase + "\t" + p1.individualCount + "\t" +
        sim.getValue("adultF_now") + "\t" + sim.getValue("adultM_now") + "\t" +
        fLaid + "\t" + eggsTotal + "\t" + eggsMean + "\t" + eggsSD + "\t" +
        meanFecScale + "\t" + meanEggsExpected + "\t" +
        sim.getValue("recruits_created") + "\t" + sim.getValue("recruits_viable") + "\t" +
        sim.getValue("culled_water") + "\t" + sim.getValue("meanSuitAdults_now") + "\t" +
        sim.getValue("meanCompRecr") + "\t" + sim.getValue("meanDDsurvRecr") + "\t" +
        sim.getValue("meanKlocRecr") + "\t" + sim.getValue("meanRHOrecr") + "\t" +
        sim.getValue("expNextN") + "\t" + sim.getValue("globalScale");

    catn(ecoLine);
    writeFile(out_eco, ecoLine, append=T);
}

function (s) getNeutLine(o pop, i year, s phase) {
    muts_m1   = unique(pop.haplosomes.mutationsOfType(m1));
    pi_global = calcHeterozygosity(pop.haplosomes, muts_m1);

    i2.evaluate(pop);
    target = pop.individuals[0];
    indvs  = unique(i2.drawByStrength(target, 50));
    pi_spatial = 0.0; spatN = 0; spatCoords = "NA";

    if (size(indvs) > 0) {
        total = 0.0;
        for (ind in indvs) {
            muts0    = ind.haplosomes[0].mutationsOfType(m1);
            muts1    = ind.haplosomes[1].mutationsOfType(m1);
            shared   = sum(match(muts0, muts1) >= 0);
            unshared = size(muts0) + size(muts1) - 2 * shared;
            total    = total + unshared / chromLen;
        }
        pi_spatial = total / size(indvs);
        spatN      = size(indvs);
        spatCoords = paste(target.spatialPosition, sep=",");
    }

    sampledInds    = sample(pop.individuals, min(TAJIMA_N, pop.individualCount));
    muts_m1_sample = unique(sampledInds.haplosomes.mutationsOfType(m1));
    D = 0.0;
    if (size(muts_m1_sample) > 0)
        D = calcTajimasD(sampledInds.haplosomes, muts_m1_sample);

    return sim.cycle + "\t" + year + "\t" + phase + "\t" + pop.id + "\t" +
        pi_global + "\t" + pi_spatial + "\t" + spatN + "\t" +
        spatCoords + "\t" + D + "\t" + pop.individualCount;
}

function (s) getPopSumm(o pop, i year, s phase) {
    inds      = pop.individuals;
    indvCount = size(inds);

    if (indvCount == 0)
        return sim.cycle + "\t" + year + "\t" + phase + "\t" + pop.id +
            "\t0\t0\t0\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA\tNA";

    frohInds = sample(inds, min(FROH_SAMPLE_N, indvCount));
    f100kb_chr9 = calcMeanFroh(frohInds, ROH_CUTOFF_100KB);
    frohN = size(frohInds);
    froh_for_load = f100kb_chr9;

    fitness_cached = pop.cachedFitness(inds.index);
    m_uniq         = unique(inds.uniqueMutationsOfType(m2));
    Mutcount       = size(m_uniq);

    if (Mutcount == 0) {
        return sim.cycle + "\t" + year + "\t" + phase + "\t" + pop.id + "\t" + indvCount +
            "\t0\t0\t0\t0\t0\t0\t0\t0\t0\t0\t" +
            f100kb_chr9 + "\t" + frohN + "\t" +
            mean(fitness_cached) + "\t" + sd(fitness_cached);
    }

    freqMut  = sim.mutationFrequencies(pop, m_uniq);
    ScoefMut = abs(m_uniq.selectionCoeff);
    DcoefMut = m_uniq.getValue("dom");

    HomAlt = sapply(m_uniq,
        "sum(inds.haplosomes[0].containsMutations(applyValue) & " +
        "inds.haplosomes[1].containsMutations(applyValue)) / indvCount;");
    Het = sapply(m_uniq,
        "sum(inds.haplosomes[0].containsMutations(applyValue) != " +
        "inds.haplosomes[1].containsMutations(applyValue)) / indvCount;");

    mHet         = mean(Het);
    mLoad_homo   = sum(ScoefMut * HomAlt);
    mLoad_hetero = sum(ScoefMut * DcoefMut * Het);
    mLoad        = mLoad_homo + mLoad_hetero;
    totalLoad    = sum(freqMut * ScoefMut);

    relzLoad = sum(freqMut^2 * ScoefMut) +
        2 * sum(freqMut * (1 - freqMut) * ScoefMut * DcoefMut);
    mskLoad  = totalLoad - relzLoad;

    relzLoad_FROH = sum((1 - froh_for_load) * freqMut^2 * ScoefMut +
        froh_for_load * freqMut * ScoefMut) +
        2 * (1 - froh_for_load) *
        sum(freqMut * (1 - freqMut) * ScoefMut * DcoefMut);
    mskLoad_FROH  = totalLoad - relzLoad_FROH;

    mutFixed = sum(HomAlt == 1.0);

    return sim.cycle + "\t" + year + "\t" + phase + "\t" + pop.id + "\t" + indvCount + "\t" +
        Mutcount + "\t" + mutFixed + "\t" + mHet + "\t" +
        mLoad_homo + "\t" + mLoad_hetero + "\t" + mLoad + "\t" +
        totalLoad + "\t" + relzLoad + "\t" + mskLoad + "\t" +
        relzLoad_FROH + "\t" + mskLoad_FROH + "\t" +
        f100kb_chr9 + "\t" + frohN + "\t" +
        mean(fitness_cached) + "\t" + sd(fitness_cached);
}


function (s) getIBDPairs(o pop, i nPairs, i year, s phase) {
    if (pop.individualCount < 2)
        return "";

    out = c();

    for (pairID in seqLen(nPairs)) {
        pairInds = pop.sampleIndividuals(2);

        ind1 = pairInds[0];
        ind2 = pairInds[1];

        muts1 = unique(ind1.haplosomes.mutationsOfType(m1));
        muts2 = unique(ind2.haplosomes.mutationsOfType(m1));

        shared = sum(match(muts1, muts2) >= 0);
        unshared = size(muts1) + size(muts2) - 2 * shared;
        diffbyBP = unshared / chromLen;

        pos1 = ind1.spatialPosition;
        pos2 = ind2.spatialPosition;
        dist = sqrt(((pos1[0] - pos2[0])^2) + ((pos1[1] - pos2[1])^2));

        out = c(out,
            sim.cycle + "\t" + year + "\t" + phase + "\t" + pairID + "\t" +
            pop.individualCount + "\t" + diffbyBP + "\t" + dist + "\t" +
            paste(pos1, sep=",") + "\t" + paste(pos2, sep=","));
    }

    return out;
}


function (s) geths(o pop) {
    m_uniq = unique(pop.individuals.uniqueMutationsOfType(m2));
    if (size(m_uniq) == 0) return "no_m2_mutations";
    freqMut  = sim.mutationFrequencies(pop, m_uniq);
    ScoefMut = abs(m_uniq.selectionCoeff);
    DcoefMut = m_uniq.getValue("dom");
    return sim.cycle + "\t" + pop.id + "\t" +
        freqMut + "\t" + ScoefMut + "\t" + DcoefMut;
}

function (void) writeSnapshot(i gen, s label) {
    sim.outputFull(out_prefix + "_fulloutput_" + label + "_gen" + gen + ".slim");
    writeMutFile(gen, label);
}

function (void) writeMutFile(i gen, s label) {
    mut = unique(p1.haplosomes.mutationsOfType(m2));
    if (size(mut) > 0) {
        out = gen + "\t" + mut.id + "\t" + mut.position + "\t" +
            mut.selectionCoeff + "\t" + mut.getValue("dom") + "\t" +
            sim.mutationFrequencies(p1, mut);
        writeFile(out_prefix + "_m2_" + label + "_gen" + gen + ".txt", out);
    }
}
