// ============================================================
// Model development: habitat-suitability landscape
//
// Development version documenting the stepwise construction of
// the spatial nonWF model for Cyaniris semiargus.
//
// Stage:
//   Introduction of an explicit habitat-suitability raster into
//   the spatial nonWF framework.
//
// Builds on:
//   02_basic_nonWF_spatial.slim
//
// Key additions:
//   - habitat-suitability raster loaded from a flat text file
//   - simulation dimensions matched to the landscape grid
//   - founders restricted to suitable habitat
//   - offspring settlement restricted to suitable habitat
//   - Poisson-distributed fecundity with an upper egg limit
//   - optional habitat-dependent egg-to-recruit survival
//
// Note:
//   Development/prototype version retained for model provenance.
//   The 553 x 299 grid used here was an intermediate landscape
//   configuration and differs from the final production grid.
//
//   Habitat-dependent survival was implemented as an option but
//   is disabled in this version (USE_HAB_SURVIVAL = F).
//
//   This script was not used directly for the final thesis runs.
//   Production models are provided in 05-burnin/ and
//   06-simulation/.
// ============================================================


// ------------------------------------------------------------
// LIFE CYCLE
//
// One cycle represents one annual generation:
//
//   1) Reproductive females choose a male.
//   2) Female egg production is drawn from a Poisson
//      distribution.
//   3) Eggs survive to recruits with probability S_total.
//   4) Recruits disperse around their mother's position.
//   5) Settlement in unsuitable habitat is avoided where
//      possible.
//   6) Recruits are limited by a global population cap.
//   7) Adults die and surviving recruits form the next
//      generation.
//
// Habitat is now spatially explicit, but population regulation
// is still global rather than based on local carrying capacity.
// ------------------------------------------------------------


initialize() {

    // --------------------------------------------------------
    // MODEL TYPE
    // --------------------------------------------------------

    initializeSLiMModelType("nonWF");
    initializeSLiMOptions(dimensionality="xy");
    initializeSex("A");


    // --------------------------------------------------------
    // DEMOGRAPHY
    // --------------------------------------------------------

    defineConstant("N0", 100);

    // Population regulation is still implemented as a single
    // global carrying-capacity cap at this stage.
    defineConstant("K", 500);


    // --------------------------------------------------------
    // FECUNDITY
    // --------------------------------------------------------

    // Mean seasonal egg production per reproducing female.
    defineConstant("MEAN_EGGS", 232.0);

    // Upper limit on realised egg production.
    defineConstant("EGG_MAX", 800);

    // Composite egg-to-next-year-adult survival.
    defineConstant("S_total", 0.10);


    // --------------------------------------------------------
    // HABITAT LANDSCAPE
    // --------------------------------------------------------

    // Flat suitability raster generated during development.
    defineConstant("map_in", "1899_suitability_flat.txt");

    // Positions at or below this value are treated as
    // unsuitable habitat.
    defineConstant("HAB_THRESH", 0.05);

    // Experimental option to multiply egg-to-recruit survival
    // by maternal habitat suitability.
    //
    // This option is deliberately OFF in this development
    // version.
    defineConstant("USE_HAB_SURVIVAL", F);


    // --------------------------------------------------------
    // SPACE
    //
    // Dimensions correspond to the intermediate raster used
    // during this stage of model development.
    // --------------------------------------------------------

    defineConstant("W", 553.0);
    defineConstant("H", 299.0);

    defineConstant("DISP_SD", 30.0);


    // --------------------------------------------------------
    // SIMULATION LENGTH
    // --------------------------------------------------------

    defineConstant("Tmax", 100);
}


// ============================================================
// STARTING POPULATION AND HABITAT MAP
// ============================================================

1 first() {

    // Create population.
    sim.addSubpop("p1", N0);

    // Match spatial bounds to raster dimensions.
    p1.setSpatialBounds(
        c(
            0.0,
            0.0,
            W,
            H
        )
    );


    // --------------------------------------------------------
    // LOAD HABITAT-SUITABILITY MAP
    // --------------------------------------------------------

    X = readFile(map_in);

    // Convert values read from the text file to floating point.
    X = asFloat(X);

    // Convert flat row-major values back into the raster grid.
    X = matrix(
        X,
        nrow=asInteger(H),
        ncol=asInteger(W),
        byrow=T
    );

    // Define spatial suitability map.
    p1.defineSpatialMap(
        "map1",
        "xy",
        X,
        interpolate=T,
        valueRange=c(
            0.0,
            1.0
        ),
        colors=c(
            "black",
            "white"
        )
    );


    // --------------------------------------------------------
    // PLACE FOUNDERS IN SUITABLE HABITAT
    // --------------------------------------------------------

    for (ind in p1.individuals) {

        pos = p1.pointUniform();

        hab = p1.spatialMapValue(
            "map1",
            pos
        );

        // Continue drawing locations until suitable habitat
        // is reached.
        while (hab <= HAB_THRESH) {

            pos = p1.pointUniform();

            hab = p1.spatialMapValue(
                "map1",
                pos
            );
        }

        ind.setSpatialPosition(pos);
    }


    // Founders begin as reproductive adults.
    p1.individuals.age = 2;


    // --------------------------------------------------------
    // OUTPUT HEADER
    // --------------------------------------------------------

    catn(
        "cycle\tN_end\tadultF\tadultM\t" +
        "females_laid\teggs_laid\t" +
        "eggs_mean_perFemale\teggs_sd_perFemale\t" +
        "recruits_created\trecruits_afterCull\t" +
        "K\tmeanHabAdults"
    );
}


// ============================================================
// RESET COUNTERS EACH CYCLE
// ============================================================

1:Tmax first() {

    sim.setValue("females_laid", 0);
    sim.setValue("eggs_laid", 0);
    sim.setValue("eggs_sq_laid", 0);
    sim.setValue("recruits_created", 0);
    sim.setValue("recruits_afterCull", 0);
}


// ============================================================
// REPRODUCTION
// ============================================================

1:Tmax reproduction(p1, "F") {

    // Only reproductive adults reproduce.
    if (individual.age < 2)
        return;


    // --------------------------------------------------------
    // MATE CHOICE
    //
    // Mate choice remains spatially unrestricted at this stage.
    // --------------------------------------------------------

    males = p1.individuals[
        p1.individuals.sex == "M" &
        p1.individuals.age >= 2
    ];

    if (males.size() == 0)
        return;

    mate = males[
        sample(
            0:(males.size() - 1),
            1
        )
    ];


    // --------------------------------------------------------
    // FECUNDITY
    //
    // This version replaces fixed female fecundity with a
    // Poisson-distributed egg number.
    // --------------------------------------------------------

    nEggs = rpois(
        1,
        MEAN_EGGS
    );

    if (nEggs > EGG_MAX)
        nEggs = EGG_MAX;

    if (nEggs <= 0)
        return;


    // --------------------------------------------------------
    // REPRODUCTION BOOKKEEPING
    // --------------------------------------------------------

    sim.setValue(
        "females_laid",
        sim.getValue("females_laid") + 1
    );

    sim.setValue(
        "eggs_laid",
        sim.getValue("eggs_laid") + nEggs
    );

    sim.setValue(
        "eggs_sq_laid",
        sim.getValue("eggs_sq_laid") +
        (nEggs * nEggs)
    );


    // --------------------------------------------------------
    // EGG-TO-RECRUIT SURVIVAL
    // --------------------------------------------------------

    momPos =
        individual.spatialPosition;

    survP =
        S_total;


    // Experimental option for maternal-habitat-dependent
    // survival. Disabled in this model version.
    if (USE_HAB_SURVIVAL) {

        habMom = p1.spatialMapValue(
            "map1",
            momPos
        );

        survP =
            S_total * habMom;
    }


    nRecruit = rbinom(
        1,
        nEggs,
        survP
    );

    if (nRecruit <= 0)
        return;


    // --------------------------------------------------------
    // CREATE AND DISPERSE RECRUITS
    // --------------------------------------------------------

    for (i in seqLen(nRecruit)) {

        off = subpop.addCrossed(
            individual,
            mate
        );

        off.age = 0;


        // Initial Gaussian dispersal proposal.
        x =
            momPos[0] +
            rnorm(
                1,
                0.0,
                DISP_SD
            );

        y =
            momPos[1] +
            rnorm(
                1,
                0.0,
                DISP_SD
            );


        // Keep proposed location inside spatial bounds.
        if (x < 0.0)
            x = 0.0;

        if (x > W)
            x = W;

        if (y < 0.0)
            y = 0.0;

        if (y > H)
            y = H;


        pos =
            c(
                x,
                y
            );

        hab = p1.spatialMapValue(
            "map1",
            pos
        );


        // ----------------------------------------------------
        // HABITAT-RESTRICTED SETTLEMENT
        //
        // If the initial position is unsuitable, draw another
        // dispersal position up to ten times.
        // ----------------------------------------------------

        tries = 0;

        while (
            hab <= HAB_THRESH &
            tries < 10
        ) {

            x =
                momPos[0] +
                rnorm(
                    1,
                    0.0,
                    DISP_SD
                );

            y =
                momPos[1] +
                rnorm(
                    1,
                    0.0,
                    DISP_SD
                );


            if (x < 0.0)
                x = 0.0;

            if (x > W)
                x = W;

            if (y < 0.0)
                y = 0.0;

            if (y > H)
                y = H;


            pos =
                c(
                    x,
                    y
                );

            hab = p1.spatialMapValue(
                "map1",
                pos
            );

            tries =
                tries + 1;
        }


        off.setSpatialPosition(pos);


        // If no suitable position was found after ten attempts,
        // mark the recruit for removal.
        if (hab <= HAB_THRESH)
            off.fitnessScaling = 0.0;
    }


    sim.setValue(
        "recruits_created",
        sim.getValue("recruits_created") +
        nRecruit
    );
}


// ============================================================
// GLOBAL POPULATION REGULATION AND GENERATION TURNOVER
// ============================================================

1:Tmax early() {

    inds =
        p1.individuals;

    adults =
        inds[
            inds.age >= 2
        ];

    recruits =
        inds[
            inds.age == 0
        ];


    // --------------------------------------------------------
    // GLOBAL CARRYING-CAPACITY CAP
    //
    // Habitat affects locations, but regulation is still a
    // global population cap in this development version.
    // --------------------------------------------------------

    if (recruits.size() > 0)
        recruits.tag = 0;


    if (recruits.size() > K) {

        keep = sample(
            recruits,
            K
        );

        keep.tag = 1;

        drop = setDifference(
            recruits,
            keep
        );

        drop.fitnessScaling = 0.0;
    }

    else {

        recruits.tag = 1;
    }


    sim.setValue(
        "recruits_afterCull",
        sum(
            recruits.tag == 1
        )
    );


    // --------------------------------------------------------
    // ANNUAL ADULT TURNOVER
    // --------------------------------------------------------

    if (adults.size() > 0)
        adults.fitnessScaling = 0.0;


    // Surviving recruits form the next reproductive generation.
    kept =
        recruits[
            recruits.tag == 1
        ];

    if (kept.size() > 0)
        kept.age = 2;
}


// ============================================================
// REPORTING
// ============================================================

1:Tmax late() {

    inds =
        p1.individuals;

    adultsNow =
        inds[
            inds.age >= 2
        ];


    nF =
        sum(
            adultsNow.sex == "F"
        );

    nM =
        sum(
            adultsNow.sex == "M"
        );


    fLaid =
        sim.getValue(
            "females_laid"
        );

    eggsTotal =
        sim.getValue(
            "eggs_laid"
        );

    eggsSq =
        sim.getValue(
            "eggs_sq_laid"
        );


    // --------------------------------------------------------
    // FECUNDITY SUMMARY
    // --------------------------------------------------------

    eggsMean = 0.0;

    eggsSD = 0.0;


    if (fLaid > 0) {

        eggsMean =
            eggsTotal /
            fLaid;

        ex2 =
            eggsSq /
            fLaid;

        var =
            ex2 -
            (eggsMean * eggsMean);

        if (var < 0.0)
            var = 0.0;

        eggsSD =
            sqrt(var);
    }


    // --------------------------------------------------------
    // HABITAT SUMMARY
    // --------------------------------------------------------

    meanHab =
        0.0;

    if (adultsNow.size() > 0)

        meanHab =
            mean(
                p1.spatialMapValue(
                    "map1",
                    adultsNow.spatialPosition
                )
            );


    // --------------------------------------------------------
    // OUTPUT
    // --------------------------------------------------------

    catn(
        sim.cycle + "\t" +
        p1.individualCount + "\t" +
        nF + "\t" +
        nM + "\t" +
        fLaid + "\t" +
        eggsTotal + "\t" +
        eggsMean + "\t" +
        eggsSD + "\t" +
        sim.getValue("recruits_created") + "\t" +
        sim.getValue("recruits_afterCull") + "\t" +
        K + "\t" +
        meanHab
    );


    if (sim.cycle == Tmax)
        sim.simulationFinished();
}
