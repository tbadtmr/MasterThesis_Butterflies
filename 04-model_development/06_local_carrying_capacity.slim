// ============================================================
// Model development: explicit local carrying capacity
//
// Development version documenting the stepwise construction of
// the spatial nonWF model for Cyaniris semiargus.
//
// Stage:
//   Introduction of an explicit local carrying-capacity term
//   derived from the relative-capacity landscape layer.
//
// Builds on:
//   05_local_density_dependence.slim
//
// Key additions:
//   - local carrying capacity (Kloc) derived from relK
//   - density-dependent survival based on local carrying
//     capacity relative to local crowding
//   - normalized Gaussian competition kernel
//   - adult-survival scaling of effective seasonal fecundity
//   - repeated spatial mate-search attempts
//   - revised local and long-distance dispersal scales
//
// Note:
//   Development/prototype version retained for model provenance.
//
//   In this version, habitat suitability and relK remain separate
//   landscape layers. Founder placement and settlement use the
//   combined suit * relK proxy, whereas local carrying capacity
//   is calculated from relK alone:
//
//       Kloc = K0_PER_PIXEL * relK
//
//   Later development replaces the separate relK formulation
//   with carrying capacity derived directly from habitat
//   suitability.
//
//   The 553 x 299 grid is an intermediate landscape
//   configuration and differs from the final production grid.
//
//   This script was not used directly for the final thesis runs.
//   Production models are provided in 05-burnin/ and
//   06-simulation/.
// ============================================================


// ------------------------------------------------------------
// LIFE CYCLE
//
// One cycle represents one annual generation:
//
//   1) Adult females select mates using a spatial interaction
//      kernel.
//   2) Effective fecundity is adjusted for within-season adult
//      survival.
//   3) Eggs survive to recruits with probability S_total.
//   4) Recruits undergo local or rare long-distance dispersal.
//   5) Settlement is restricted using suit * relK.
//   6) Recruit survival depends on local carrying capacity and
//      local competition.
//   7) Adults die at the end of the season.
//   8) Surviving recruits form the next generation.
// ------------------------------------------------------------


initialize() {

    // --------------------------------------------------------
    // MODEL TYPE
    // --------------------------------------------------------

    initializeSLiMModelType("nonWF");
    initializeSLiMOptions(dimensionality="xy");
    initializeSex("A");


    // --------------------------------------------------------
    // DEMOGRAPHY AND REPRODUCTION
    // --------------------------------------------------------

    defineConstant("N0", 1000);

    // Potential seasonal fecundity per female.
    defineConstant("MEAN_EGGS", 232.0);

    // Upper limit on realised egg production.
    defineConstant("EGG_MAX", 800);

    // Baseline egg-to-recruit survival before local density
    // dependence.
    defineConstant("S_total", 0.08);


    // --------------------------------------------------------
    // WITHIN-SEASON ADULT SURVIVAL
    //
    // Experimental scaling of seasonal fecundity according to
    // expected female survival through the flight season.
    // --------------------------------------------------------

    defineConstant("USE_ADULT_SURV_SCALE", T);
    defineConstant("SEASON_DAYS", 10);
    defineConstant("ADULT_DAILY_SURV_F", 0.80);


    // --------------------------------------------------------
    // SPACE
    //
    // Intermediate development landscape.
    // --------------------------------------------------------

    defineConstant("W", 553.0);
    defineConstant("H", 299.0);


    // Local dispersal scale in map units.
    defineConstant("DISP_SD", 0.15);

    // Rare long-distance dispersal.
    defineConstant("P_LDD", 0.01);
    defineConstant("DISP_SD_LDD", 1.0);


    // --------------------------------------------------------
    // LANDSCAPE INPUTS
    //
    // suit = habitat suitability
    // relK = relative-capacity proxy
    //
    // Founder placement and offspring settlement use:
    //
    //   opt = suit * relK
    // --------------------------------------------------------

    defineConstant(
        "map_suit_in",
        "/home/tabea/MasterThesis/Model_Input/1899_suitability_flat.txt"
    );

    defineConstant(
        "map_relK_in",
        "/home/tabea/MasterThesis/Model_Input/relK_1899_flat.txt"
    );


    // Combined habitat values at or below this threshold are
    // treated as unusable.
    defineConstant("OPT_THRESH", 0.05);


    // --------------------------------------------------------
    // LOCAL COMPETITION
    // --------------------------------------------------------

    // Competition-kernel standard deviation.
    defineConstant("SI", 3.0);


    // --------------------------------------------------------
    // LOCAL CARRYING CAPACITY
    //
    // Capacity of a pixel when relK = 1.
    //
    // In this development formulation:
    //
    //   Kloc = K0_PER_PIXEL * relK
    // --------------------------------------------------------

    defineConstant("K0_PER_PIXEL", 50.0);


    // Scaling between local competition and local carrying
    // capacity.
    defineConstant("ALPHA_COMP", 50.0);


    // Maximum recruit survival after density dependence.
    defineConstant("MAX_SURV", 0.95);


    // --------------------------------------------------------
    // SPATIAL MATE CHOICE
    // --------------------------------------------------------

    // Mate-search kernel standard deviation.
    defineConstant("SM", 5.0);

    // Number of mate-search attempts.
    defineConstant("MATE_TRIES", 5);


    // --------------------------------------------------------
    // INITIAL PLACEMENT
    //
    // Retained from development experiments. This flag is
    // defined here but is not used by the placement routine in
    // this particular version.
    // --------------------------------------------------------

    defineConstant("INIT_BIASED", F);


    // --------------------------------------------------------
    // SIMULATION LENGTH
    // --------------------------------------------------------

    defineConstant("Tmax", 1000);


    // --------------------------------------------------------
    // SPATIAL INTERACTIONS
    //
    // i1 = local competition
    // i2 = female-male mate choice
    // --------------------------------------------------------

    initializeInteractionType(
        1,
        "xy",
        reciprocal=T,
        maxDistance=SI * 3
    );

    // Normalized Gaussian competition kernel.
    i1.setInteractionFunction(
        "n",
        1.0 / (2.0 * PI * SI^2),
        SI
    );


    initializeInteractionType(
        2,
        "xy",
        reciprocal=T,
        maxDistance=SM * 3,
        sexSegregation="FM"
    );

    i2.setInteractionFunction(
        "n",
        1.0,
        SM
    );
}


// ============================================================
// STARTING POPULATION AND LANDSCAPE MAPS
// ============================================================

1 first() {

    // Create population.
    sim.addSubpop("p1", N0);

    // Match spatial bounds to the landscape grid.
    p1.setSpatialBounds(
        c(
            0.0,
            0.0,
            W,
            H
        )
    );


    // --------------------------------------------------------
    // LOAD HABITAT-SUITABILITY MAP
    // --------------------------------------------------------

    Xs =
        asFloat(
            readFile(
                map_suit_in
            )
        );

    Xs =
        matrix(
            Xs,
            nrow=asInteger(H),
            ncol=asInteger(W),
            byrow=T
        );


    // --------------------------------------------------------
    // LOAD RELATIVE-CAPACITY MAP
    // --------------------------------------------------------

    Xk =
        asFloat(
            readFile(
                map_relK_in
            )
        );

    Xk =
        matrix(
            Xk,
            nrow=asInteger(H),
            ncol=asInteger(W),
            byrow=T
        );


    // --------------------------------------------------------
    // DEFINE SPATIAL MAPS
    // --------------------------------------------------------

    p1.defineSpatialMap(
        "suit",
        "xy",
        Xs,
        interpolate=T,
        valueRange=c(0.0, 1.0),
        colors=c("black", "green")
    );


    p1.defineSpatialMap(
        "relK",
        "xy",
        Xk,
        interpolate=T,
        valueRange=c(0.0, 1.0),
        colors=c("black", "green")
    );


    // --------------------------------------------------------
    // PLACE FOUNDERS IN USABLE HABITAT
    //
    // Usability is determined by:
    //
    //   opt = suit * relK
    // --------------------------------------------------------

    for (ind in p1.individuals) {

        tries = 0;


        while (T) {

            pos =
                p1.pointUniform();


            opt =
                p1.spatialMapValue(
                    "suit",
                    pos
                ) *
                p1.spatialMapValue(
                    "relK",
                    pos
                );


            if (opt > OPT_THRESH) {

                ind.setSpatialPosition(
                    pos
                );

                break;
            }


            tries =
                tries + 1;


            if (tries > 100000)

                stop(
                    "Cannot place individuals: OPT_THRESH too high or map has few suitable cells."
                );
        }
    }


    // Founders begin as reproductive adults.
    p1.individuals.age = 2;


    // --------------------------------------------------------
    // OUTPUT HEADER
    // --------------------------------------------------------

    catn(
        "cycle\tN_end\tadultF\tadultM\t" +
        "females_laid\teggs_laid\t" +
        "eggs_mean\teggs_sd\t" +
        "recruits_created\trecruits_survived\t" +
        "meanSuit\tmeanRelK\tmeanOpt\t" +
        "meanCompRecr\tmeanDDsurvRecr"
    );
}


// ============================================================
// RESET COUNTERS AND UPDATE MATE INTERACTIONS
// ============================================================

1:Tmax first() {

    // At the start of cycle t, reproductive adults represent
    // recruits that survived the previous cycle.
    if (sim.cycle == 1)

        sim.setValue(
            "recruits_survived",
            0
        );

    else

        sim.setValue(
            "recruits_survived",
            sum(
                p1.individuals.age >= 2
            )
        );


    sim.setValue(
        "females_laid",
        0
    );

    sim.setValue(
        "eggs_laid",
        0
    );

    sim.setValue(
        "eggs_sq_laid",
        0
    );

    sim.setValue(
        "recruits_created",
        0
    );

    sim.setValue(
        "meanCompRecr",
        0.0
    );

    sim.setValue(
        "meanDDsurvRecr",
        0.0
    );


    // Update spatial mate-search neighborhoods.
    i2.evaluate(p1);
}


// ============================================================
// REPRODUCTION
// ============================================================

1:Tmax reproduction(p1, "F") {

    // Only reproductive adults reproduce.
    if (individual.age < 2)
        return;


    // --------------------------------------------------------
    // SPATIAL MATE CHOICE
    // --------------------------------------------------------

    mate = NULL;


    for (t in seqLen(MATE_TRIES)) {

        mTry =
            i2.drawByStrength(
                individual,
                1
            );


        if (mTry.size() != 0) {

            mate =
                mTry;

            break;
        }
    }


    if (isNULL(mate))
        return;


    // --------------------------------------------------------
    // EFFECTIVE SEASONAL FECUNDITY
    // --------------------------------------------------------

    meanEggsEff =
        MEAN_EGGS;


    if (USE_ADULT_SURV_SCALE) {

        s =
            ADULT_DAILY_SURV_F;

        D =
            asInteger(
                SEASON_DAYS
            );


        if (s >= 0.999999)

            fracAlive =
                1.0;

        else {

            expDays =
                (1.0 - (s^D)) /
                (1.0 - s);


            fracAlive =
                expDays /
                D;


            if (fracAlive < 0.0)
                fracAlive = 0.0;

            if (fracAlive > 1.0)
                fracAlive = 1.0;
        }


        meanEggsEff =
            MEAN_EGGS *
            fracAlive;
    }


    // --------------------------------------------------------
    // REALISED EGG PRODUCTION
    // --------------------------------------------------------

    nEggs =
        rpois(
            1,
            meanEggsEff
        );


    if (nEggs > EGG_MAX)
        nEggs = EGG_MAX;


    if (nEggs <= 0)
        return;


    // --------------------------------------------------------
    // REPRODUCTION BOOKKEEPING
    // --------------------------------------------------------

    sim.setValue(
        "females_laid",
        sim.getValue("females_laid") + 1
    );

    sim.setValue(
        "eggs_laid",
        sim.getValue("eggs_laid") +
        nEggs
    );

    sim.setValue(
        "eggs_sq_laid",
        sim.getValue("eggs_sq_laid") +
        (nEggs * nEggs)
    );


    momPos =
        individual.spatialPosition;


    // --------------------------------------------------------
    // EGG-TO-RECRUIT SURVIVAL
    // --------------------------------------------------------

    nRecruit =
        rbinom(
            1,
            nEggs,
            S_total
        );


    if (nRecruit <= 0)
        return;


    // --------------------------------------------------------
    // CREATE AND DISPERSE RECRUITS
    // --------------------------------------------------------

    for (i in seqLen(nRecruit)) {

        off =
            subpop.addCrossed(
                individual,
                mate
            );

        off.age = 0;


        // ----------------------------------------------------
        // LOCAL VS LONG-DISTANCE DISPERSAL
        // ----------------------------------------------------

        sdHere =
            DISP_SD;


        if (runif(1) < P_LDD)

            sdHere =
                DISP_SD_LDD;


        // Initial dispersal proposal.
        x =
            momPos[0] +
            rnorm(
                1,
                0.0,
                sdHere
            );


        y =
            momPos[1] +
            rnorm(
                1,
                0.0,
                sdHere
            );


        // Keep positions within model bounds.
        if (x < 0.0)
            x = 0.0;

        if (x > W)
            x = W;

        if (y < 0.0)
            y = 0.0;

        if (y > H)
            y = H;


        pos =
            c(
                x,
                y
            );


        // ----------------------------------------------------
        // HABITAT-RESTRICTED SETTLEMENT
        // ----------------------------------------------------

        tries =
            0;


        opt =
            p1.spatialMapValue(
                "suit",
                pos
            ) *
            p1.spatialMapValue(
                "relK",
                pos
            );


        while (
            opt <= OPT_THRESH &
            tries < 10
        ) {

            x =
                momPos[0] +
                rnorm(
                    1,
                    0.0,
                    sdHere
                );


            y =
                momPos[1] +
                rnorm(
                    1,
                    0.0,
                    sdHere
                );


            if (x < 0.0)
                x = 0.0;

            if (x > W)
                x = W;

            if (y < 0.0)
                y = 0.0;

            if (y > H)
                y = H;


            pos =
                c(
                    x,
                    y
                );


            opt =
                p1.spatialMapValue(
                    "suit",
                    pos
                ) *
                p1.spatialMapValue(
                    "relK",
                    pos
                );


            tries =
                tries + 1;
        }


        off.setSpatialPosition(
            pos
        );


        // If no usable location was found after ten attempts,
        // mark the recruit for removal.
        if (opt <= OPT_THRESH)

            off.fitnessScaling =
                0.0;
    }


    sim.setValue(
        "recruits_created",
        sim.getValue("recruits_created") +
        nRecruit
    );
}


// ============================================================
// LOCAL CARRYING CAPACITY, DENSITY DEPENDENCE AND TURNOVER
// ============================================================

1:Tmax early() {

    inds =
        p1.individuals;


    adults =
        inds[
            inds.age >= 2
        ];


    recruits =
        inds[
            inds.age == 0
        ];


    // Update local competition neighborhoods.
    i1.evaluate(p1);


    if (recruits.size() > 0) {

        // ----------------------------------------------------
        // LOCAL CROWDING
        // ----------------------------------------------------

        comp =
            i1.totalOfNeighborStrengths(
                recruits
            );


        posR =
            recruits.spatialPosition;


        suitR =
            p1.spatialMapValue(
                "suit",
                posR
            );


        relKR =
            p1.spatialMapValue(
                "relK",
                posR
            );


        // ----------------------------------------------------
        // LOCAL CARRYING CAPACITY
        //
        // First explicit Kloc formulation:
        //
        //   Kloc = K0_PER_PIXEL * relK
        //
        // Suitability is still used for occupancy/settlement,
        // whereas relK controls local capacity.
        // ----------------------------------------------------

        Kloc =
            K0_PER_PIXEL *
            relKR;


        // Alternative formulation explored conceptually during
        // development:
        //
        // Kloc =
        //     K0_PER_PIXEL *
        //     (suitR * relKR);


        // ----------------------------------------------------
        // DENSITY-DEPENDENT RECRUIT SURVIVAL
        //
        // Survival increases with Kloc and decreases with local
        // crowding.
        // ----------------------------------------------------

        dd =
            Kloc /
            (
                Kloc +
                ALPHA_COMP * comp
            );


        dd =
            pmin(
                MAX_SURV,
                dd
            );


        recruits.fitnessScaling =
            recruits.fitnessScaling *
            dd;


        sim.setValue(
            "meanCompRecr",
            mean(comp)
        );


        sim.setValue(
            "meanDDsurvRecr",
            mean(dd)
        );
    }


    // --------------------------------------------------------
    // ANNUAL ADULT TURNOVER
    // --------------------------------------------------------

    if (adults.size() > 0)

        adults.fitnessScaling =
            0.0;


    if (recruits.size() > 0)

        recruits.age =
            2;
}


// ============================================================
// REPORTING
// ============================================================

1:Tmax late() {

    // Stop explicitly if the population has gone extinct.
    if (p1.individualCount == 0) {

        catn(
            sim.cycle +
            "\t0\t0\t0\t0\t0\t0\t0\t0\t" +
            sim.getValue("recruits_survived") +
            "\t0\t0\t0\t0\t0"
        );


        sim.simulationFinished();

        return;
    }


    inds =
        p1.individuals;


    adultsNow =
        inds[
            inds.age >= 2
        ];


    nF =
        sum(
            adultsNow.sex == "F"
        );


    nM =
        sum(
            adultsNow.sex == "M"
        );


    fLaid =
        sim.getValue(
            "females_laid"
        );


    eggsTotal =
        sim.getValue(
            "eggs_laid"
        );


    eggsSq =
        sim.getValue(
            "eggs_sq_laid"
        );


    // --------------------------------------------------------
    // FECUNDITY SUMMARY
    // --------------------------------------------------------

    eggsMean =
        0.0;


    eggsSD =
        0.0;


    if (fLaid > 0) {

        eggsMean =
            eggsTotal /
            fLaid;


        ex2 =
            eggsSq /
            fLaid;


        var =
            ex2 -
            (eggsMean * eggsMean);


        if (var < 0.0)
            var = 0.0;


        eggsSD =
            sqrt(var);
    }


    // --------------------------------------------------------
    // LANDSCAPE SUMMARY
    // --------------------------------------------------------

    meanSuit =
        0.0;


    meanRelK =
        0.0;


    meanOpt =
        0.0;


    if (adultsNow.size() > 0) {

        posA =
            adultsNow.spatialPosition;


        sA =
            p1.spatialMapValue(
                "suit",
                posA
            );


        kA =
            p1.spatialMapValue(
                "relK",
                posA
            );


        meanSuit =
            mean(sA);


        meanRelK =
            mean(kA);


        meanOpt =
            mean(
                sA * kA
            );
    }


    // --------------------------------------------------------
    // OUTPUT
    // --------------------------------------------------------

    catn(
        sim.cycle + "\t" +
        p1.individualCount + "\t" +
        nF + "\t" +
        nM + "\t" +
        fLaid + "\t" +
        eggsTotal + "\t" +
        eggsMean + "\t" +
        eggsSD + "\t" +
        sim.getValue("recruits_created") + "\t" +
        sim.getValue("recruits_survived") + "\t" +
        meanSuit + "\t" +
        meanRelK + "\t" +
        meanOpt + "\t" +
        sim.getValue("meanCompRecr") + "\t" +
        sim.getValue("meanDDsurvRecr")
    );


    if (sim.cycle == Tmax)

        sim.simulationFinished();
}
